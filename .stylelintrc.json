{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["coverage/**"],
  "rules": {
    "selector-class-pattern": [
      "^lz-[a-z0-9]+(?:-[a-z0-9]+)*$",
      {
        "resolveNestedSelectors": true,
        "message": "CSS-Klassen muessen kebab-case mit lz- Praefix verwenden"
      }
    ]
  }
}
